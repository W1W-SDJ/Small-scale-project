# dependencies (Electron is a devDependency; there is no runtime dependency)
node_modules/

# local development log, not part of the published repo
.dev/

# regenerated by tools/matte.mjs / tools/*.mjs preview outputs
assets/pet-preview.png
*-preview.png

# download cache used by tools/get-electron.mjs
.electron-cache/

# build output (portable exe, folder build, zip) — never commit 100+ MB binaries
dist/
out/
release/
*.zip

# logs and local runtime state
*.log
pet-state.json
digest.json
config.json

# OS noise
.DS_Store
Thumbs.db
desktop.ini

# editors
.vscode/
.idea/
